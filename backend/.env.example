# ─────────────────────────────────────────────────────────────────────
# DeskAgent Backend configuration.
# Copy this file to `.env` and fill in your values, then `docker compose up`.
# All keys are optional unless noted; defaults live in components/config.py.
# Pydantic-settings is case-insensitive, so LLM_API_KEY == llm_api_key.
# ─────────────────────────────────────────────────────────────────────

# ── Runtime ──
APP_ENV=production
# In Docker the service hostname is `postgres`; for local dev use localhost:5432.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/deskagent
# CHANGE THIS. Must be ≥ 16 chars; used to sign JWTs.
JWT_SECRET_KEY=replace-this-with-a-strong-secret

# ── Bootstrap admin account (created on first boot) ──
ADMIN_USERNAME=deskagent
ADMIN_PASSWORD=deskagent@admin123

# ── Public URL prefix for self-hosted media files ──
# Leave empty to auto-detect public IP. Set explicitly for production, e.g.
# PUBLIC_URL_PREFIX=https://deskagent.example.com
PUBLIC_URL_PREFIX=

# ═══════════════════════════════════════════════════════════════════════
# Model providers — five capabilities, each independently configurable.
#
# PROVIDER is the primary selector (mimo or minimax). Each provider ships
# default BASE_URLs, so BASE_URL is optional — set it only to override.
# API_KEY falls back per provider: MiMo services (chat/stt/tts) share
# LLM_API_KEY; MiniMax services (image/video) share MINIMAX_API_KEY.
#
# Minimal config: set LLM_API_KEY + MINIMAX_API_KEY, leave everything else
# empty — each capability uses its default provider + URL.
# ═══════════════════════════════════════════════════════════════════════

# ── Chat / dialog (LLM) — default provider: mimo ──
# MIMO_KEY is accepted as an alias for LLM_API_KEY.
LLM_PROVIDER=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_NAME=mimo-v2.5-pro

# ── Speech-to-text (STT) — default provider: mimo, inherits LLM_API_KEY ──
STT_PROVIDER=
STT_BASE_URL=
STT_API_KEY=
STT_MODEL_NAME=mimo-v2.5-asr

# ── Text-to-speech (TTS) — default provider: mimo, inherits LLM_API_KEY ──
TTS_PROVIDER=
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL_NAME=mimo-v2.5-tts
TTS_DEFAULT_VOICE=mimo_default

# ── Image generation (portrait / avatar) — default provider: minimax ──
# Empty IMAGE_GEN_API_KEY → inherits MINIMAX_API_KEY.
IMAGE_GEN_PROVIDER=
IMAGE_GEN_BASE_URL=
IMAGE_GEN_API_KEY=
IMAGE_GEN_MODEL_NAME=image-01

# ── Video generation (companion animation clips) — default provider: minimax ──
# Empty VIDEO_GEN_API_KEY → inherits MINIMAX_API_KEY.
VIDEO_GEN_PROVIDER=
VIDEO_GEN_BASE_URL=
VIDEO_GEN_API_KEY=
VIDEO_GEN_MODEL_NAME=MiniMax-Hailuo-02

# ── MiniMax shared key (image + video gen when provider is minimax) ──
# MINIMAX_KEY is accepted as an alias for MINIMAX_API_KEY. Required when
# any *_BASE_URL points at api.minimaxi.com / api.minimax.io — a MiMo
# (LLM_API_KEY) sent to a MiniMax host always 401s.
MINIMAX_API_KEY=

# ── LLM resilience (optional tuning) ──
LLM_REQUEST_TIMEOUT_SECONDS=300
LLM_MAX_RETRY_ATTEMPTS=3
