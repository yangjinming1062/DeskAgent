# ─────────────────────────────────────────────────────────────────────
# DeskAgent Backend configuration.
# Copy this file to `.env` and fill in your values, then `docker compose up`.
# All keys are optional unless noted; defaults live in components/config.py.
# Pydantic-settings is case-insensitive, so LLM_API_KEY == llm_api_key.
# ─────────────────────────────────────────────────────────────────────

# ── Runtime ──
APP_ENV=production
# In Docker the service hostname is `postgres`; for local dev use localhost:5432.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/deskagent
# CHANGE THIS. Must be ≥ 16 chars; used to sign JWTs.
JWT_SECRET_KEY=replace-this-with-a-strong-secret

# ── Bootstrap admin account (created on first boot) ──
ADMIN_USERNAME=deskagent
ADMIN_PASSWORD=deskagent@admin123

# ── Public URL prefix for self-hosted media files ──
# Leave empty to auto-detect public IP. Set explicitly for production, e.g.
# PUBLIC_URL_PREFIX=https://deskagent.example.com
PUBLIC_URL_PREFIX=

# ═══════════════════════════════════════════════════════════════════════
# Model providers — PROVIDER-first configuration.
#
# Declare providers in `PROVIDERS` (priority order, first wins). Each provider
# has its own key + optional base_url. Per-capability `*_PROVIDER` overrides
# reorder the chain (move named provider to the front); other providers in
# the chain remain fallback candidates. Per-capability `*_API_KEY` /
# `*_BASE_URL` / `*_MODEL_NAME` (set below) take priority over provider-level
# when both are configured.
#
# Default MODEL_NAME per capability lives in each provider class's
# `DEFAULT_MODELS` ClassVar (see services/llm/providers/{mimo,minimax}/).
#
# Two provider families ship today:
#   mimo    — chat / stt / tts / image_gen (Xiaomi MiMo, OpenAI-compatible)
#   minimax — chat / tts / image_gen / video_gen (MiniMax, no public STT)
#
# Minimal config: set LLM_API_KEY + MINIMAX_API_KEY only — each provider uses
# its default base_url and default model for every capability it supports.
# ═══════════════════════════════════════════════════════════════════════

# ── PROVIDER list (priority order) ──
PROVIDERS=mimo,minimax

# ── MiMo (Xiaomi MiMo) — chat / stt / tts / image_gen ──
# MIMO_API_KEY also reads legacy MIMO_KEY. LLM_API_KEY continues to flow
# into the per-cap `llm_api_key` field (highest priority for the chat slot).
MIMO_API_KEY=
MIMO_BASE_URL=        # optional; default https://token-plan-cn.xiaomimimo.com/v1

# ── MiniMax — chat / tts / image_gen / video_gen (no stt) ──
# Legacy alias: MINIMAX_KEY.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=     # optional; default https://api.minimaxi.com/v1

# ── Per-capability overrides (all OPTIONAL — only set what you need) ──
# `*_PROVIDER` soft-reorders: named provider goes first in the chain, others
# remain eligible as fallback candidates. `*_API_KEY` / `*_BASE_URL` /
# `*_MODEL_NAME` override provider-level values for that capability slot
# only (operator's direct per-cap intent — wins over PROVIDERS list).

# Chat / dialog (LLM) — default provider: mimo
LLM_PROVIDER=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_NAME=

# Speech-to-text (STT) — default provider: mimo (only mimo registers STT)
STT_PROVIDER=
STT_BASE_URL=
STT_API_KEY=
STT_MODEL_NAME=

# Text-to-speech (TTS) — default provider: mimo
TTS_PROVIDER=
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL_NAME=
TTS_DEFAULT_VOICE=mimo_default

# Image generation — default provider: minimax (MiniMax image-01)
IMAGE_GEN_PROVIDER=
IMAGE_GEN_BASE_URL=
IMAGE_GEN_API_KEY=
IMAGE_GEN_MODEL_NAME=

# Video generation — only minimax registers video_gen
VIDEO_GEN_PROVIDER=
VIDEO_GEN_BASE_URL=
VIDEO_GEN_API_KEY=
VIDEO_GEN_MODEL_NAME=

# ── LLM resilience (optional tuning) ──
LLM_REQUEST_TIMEOUT_SECONDS=300
LLM_MAX_RETRY_ATTEMPTS=3