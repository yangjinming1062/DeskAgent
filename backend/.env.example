# ─────────────────────────────────────────────────────────────────────
# DeskAgent Backend configuration.
# Copy this file to `.env` and fill in your values, then `docker compose up`.
# All keys are optional unless noted; defaults live in components/config.py.
# Pydantic-settings is case-insensitive, so LLM_API_KEY == llm_api_key.
# ─────────────────────────────────────────────────────────────────────

# ─── Runtime ───
APP_NAME=DeskAgent Backend
# URL prefix mounted on the FastAPI app (router registration).
API_PREFIX=/api

# ─── Database ───
# SQLAlchemy URL. In Docker the service hostname is `postgres`;
# for local dev use localhost:5432.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/deskagent

# ─── Auth & Admin ───
# CHANGE THIS. Must be ≥ 16 chars; used to sign JWTs.
JWT_SECRET_KEY=replace-this-with-a-strong-secret
JWT_ALGORITHM=HS256
# 8 hours.
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Bootstrap admin account (created on first boot).
ADMIN_USERNAME=deskagent
ADMIN_PASSWORD=deskagent@admin123

# ─── Public URL & Temp Files ───
# Public URL prefix Desktop/Runner uses to fetch self-hosted media
# (e.g. https://deskagent.example.com). Leave empty to auto-detect
# the public IP at startup. Set explicitly when behind a reverse proxy.
PUBLIC_URL_PREFIX=
# Auto-detected at startup; used only when PUBLIC_URL_PREFIX is empty.
PUBLIC_IP=
# Backend HTTP port — used to build URLs when PUBLIC_URL_PREFIX is empty.
PORT=8000
# TTL for files served by /temp-media/{token}.
TEMP_FILE_TTL_HOURS=24
# Root for backend-side disk artifacts:
#   $DATA_DIR/temp-media/                — TTL'd by TEMP_FILE_TTL_HOURS
#   $DATA_DIR/desktop-attachments/{session_id}/  — GC'd on session delete
DATA_DIR=./data

# ═══════════════════════════════════════════════════════════════════════
# Model providers — PROVIDER-first configuration.
#
# Declare providers in `PROVIDERS` (priority order, first wins). Each provider
# has its own key + optional base_url. Per-capability `*_PROVIDER` overrides
# reorder the chain (move named provider to the front); other providers in
# the chain remain fallback candidates. Per-capability `*_API_KEY` /
# `*_BASE_URL` / `*_MODEL_NAME` (set below) take priority over provider-level
# when both are configured.
#
# Default MODEL_NAME per capability lives in each provider class's
# `DEFAULT_MODELS` ClassVar (see services/llm/providers/{mimo,minimax,gemini}/).
#
# Three provider families ship today:
#   mimo    — chat / stt / tts / image_gen (Xiaomi MiMo, OpenAI-compatible)
#   minimax — chat / tts / image_gen / video_gen (MiniMax, no public STT)
#   gemini  — chat / stt / tts / image_gen (Google Gemini; video_gen 需 Vertex AI)
#   zhipu   — chat / stt / tts / image_gen (智谱 BigModel; OpenAI-compatible)
#
# Minimal config: set LLM_API_KEY + MINIMAX_API_KEY only — each provider uses
# its default base_url and default model for every capability it supports.
# ═══════════════════════════════════════════════════════════════════════

# ─── Provider chain ───
PROVIDERS=mimo,minimax,gemini,zhipu

# MiMo (Xiaomi MiMo) — chat / stt / tts / image_gen
# MIMO_API_KEY also reads legacy MIMO_KEY.
MIMO_API_KEY=
MIMO_BASE_URL=

# MiniMax — chat / tts / image_gen / video_gen (no stt)
# Legacy alias: MINIMAX_KEY.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=

# Gemini — chat / stt / tts / image_gen (Google Gemini)
# Legacy alias: GEMINI_KEY.
# Default models: llm=gemini-3.6-flash, stt=gemini-2.5-flash,
#                 tts=gemini-2.5-flash-preview-tts,
#                 image_gen=gemini-2.5-flash-image
GEMINI_API_KEY=
GEMINI_BASE_URL=      # optional; chat default https://generativelanguage.googleapis.com/v1beta/openai/

# Zhipu (智谱 BigModel) — chat / stt / tts / image_gen (OpenAI-compatible)
# Legacy alias: ZHIPU_KEY.
# Default models: llm=glm-5.2, stt=glm-asr-2512, tts=glm-tts, image_gen=glm-image
ZHIPU_API_KEY=
ZHIPU_BASE_URL=       # optional; default https://open.bigmodel.cn/api/paas/v4

# ─── LLM (chat) ───
# Per-capability overrides — empty falls back to provider-level defaults.
LLM_PROVIDER=
LLM_BASE_URL=
# LLM_API_KEY continues to flow into the per-cap llm_api_key field
# (highest priority for the chat slot).
LLM_API_KEY=
LLM_MODEL_NAME=
# Override the LLM context-window length. Empty / unset falls through to
# the active provider's DEFAULT_CONTEXT_TOKENS, then to
# DEFAULT_LLM_CONTEXT_TOKENS below. Set this when LLM_MODEL_NAME points
# to a model whose window differs from its provider's published default.
LLM_CONTEXT_TOKENS=
# LLM call resilience — applied by services.llm_retry.call_with_retry.
LLM_REQUEST_TIMEOUT_SECONDS=300
LLM_MAX_RETRY_ATTEMPTS=3
LLM_BASE_RETRY_DELAY=5
LLM_MAX_RETRY_DELAY=60

# ─── STT (speech-to-text) ───
# Empty *_BASE_URL / *_API_KEY fall back to llm_base_url / llm_api_key.
STT_PROVIDER=
STT_BASE_URL=
STT_API_KEY=
STT_MODEL_NAME=
STT_CONTEXT_TOKENS=

# ─── TTS (text-to-speech) ───
# Empty *_BASE_URL / *_API_KEY fall back to llm_base_url / llm_api_key.
TTS_PROVIDER=
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL_NAME=
TTS_CONTEXT_TOKENS=

# ─── Image Gen ───
# Empty *_API_KEY inherits MINIMAX_API_KEY (minimax provider).
IMAGE_GEN_PROVIDER=
IMAGE_GEN_BASE_URL=
IMAGE_GEN_API_KEY=
IMAGE_GEN_MODEL_NAME=
IMAGE_GEN_CONTEXT_TOKENS=

# ─── Video Gen ───
# Empty *_API_KEY inherits MINIMAX_API_KEY (minimax provider).
VIDEO_GEN_PROVIDER=
VIDEO_GEN_BASE_URL=
VIDEO_GEN_API_KEY=
VIDEO_GEN_MODEL_NAME=
VIDEO_GEN_CONTEXT_TOKENS=
# Poll cadence when waiting on provider's async video job.
VIDEO_GEN_POLL_INTERVAL_SECONDS=5
# Hard cap on total poll wait before bailing out.
VIDEO_GEN_MAX_POLL_SECONDS=900
# How long chat will block on a synchronous video_gen tool call before
# returning a synthetic timeout tool message.
VIDEO_GEN_TOOL_WAIT_SECONDS=180
# Safety cap on downloaded video bytes (≈ 200 MB).
VIDEO_GEN_DOWNLOAD_MAX_BYTES=209715200

# ─── Companion clip escalation ───
# The desktop companion renders each scene at the best available tier of a
# three-tier fallback ladder, so video-gen cost/quotas never block startup:
#   Tier 1 — portrait + state-driven CSS animation (no asset, always ready)
#   Tier 2 — one image-gen sprite sheet per scene (cheaper than video)
#   Tier 3 — image-to-video clip (costly, quota-bound)
# active_tier = max(ready tier) (3 > 2 > 1). A background escalation loop
# drives each scene upward (finalize video jobs → retry failed video →
# generate keyframes) with exponential backoff; failures are retried until
# success, never silently dropped. Full design: COMPANION_DESIGN.md §1.4.
# How often the escalation loop runs one pass. Lower = scenes climb to
# video faster but more DB + provider polling; 60s is a calm default.
CLIP_ESCALATION_INTERVAL_SECONDS=60
# Per-user daily cap on NEW Tier-3 (video) submissions. Tunes to a provider
# subscription that grants only a few video generations per day — Tier 1/2
# keep the companion alive and smooth in the meantime, and every scene
# climbs to video over successive days. 0 disables Tier-3 entirely
# (companion stays on Tier 1/2 forever). Count resets at local midnight.
CLIP_VIDEO_DAILY_BUDGET=3

# ─── Chat service ───
# Context-window compression — applied by services/llm/context_compressor.
# Fallback defaults; per-user values (chat.enable_context_compression,
# chat.context_compression_threshold) set via /api/config take precedence.
CONTEXT_COMPRESSION_THRESHOLD=0.70
CONTEXT_SUMMARY_TARGET_TOKENS=2000
CONTEXT_SUMMARY_MAX_INPUT_MESSAGES=30
ENABLE_CONTEXT_COMPRESSION=true

# Global context-window terminal fallback. Each per-capability
# ``<cap>_CONTEXT_TOKENS`` (declared above, next to its ``<cap>_MODEL_NAME``)
# wins first; the active provider's ``DEFAULT_CONTEXT_TOKENS`` wins second;
# this value is the third-and-last layer (e.g. a capability the active
# provider doesn't register, like ``mimo/video_gen``).
# 1_000_000 matches the team's "modern LLMs all have 1M context" stance.
DEFAULT_LLM_CONTEXT_TOKENS=1000000

# Per-capability overrides (uncomment to pin):
# LLM_CONTEXT_TOKENS=1000000
# STT_CONTEXT_TOKENS=8000
# TTS_CONTEXT_TOKENS=8000
# IMAGE_GEN_CONTEXT_TOKENS=8000
# VIDEO_GEN_CONTEXT_TOKENS=8000
# IPC future timeout — applied by services.ipc.await_future. Caps how long
# chat will block waiting for a runner tool result before falling back
# to a synthetic "runner offline" tool message.
IPC_FUTURE_TIMEOUT_SECONDS=300
# Per-user "recently active chat" window for GET /api/status's chat_count.
# Counts Conversation rows updated within the last N minutes.
CHAT_ACTIVE_WINDOW_MINUTES=30

# ─── Voice / STT operator fallbacks ───
# Seed values used only when the per-user /api/config row is absent (fresh
# install before the user opens the settings page). The /api/config defaults
# (see api/v1/config.py DEFAULT_CONFIG) win once the settings UI has run.
# Master switch for the deskagent:media:stt IPC. false → STT rejects
# immediately with "STT is disabled in settings", no local/cloud work.
ENABLE_STT=true
# Single-voice-recording cap (seconds). Consumed by the companion dock's
# MediaRecorder auto-stop timer. Must be > 0.
MAX_RECORDING_SECONDS=60

# ─── Rate limiting ───
# Master switch — false makes the limiter a no-op. In-memory backend
# (N replicas = N× effective rate per user). Tunable per .env without
# code change.
RATE_LIMIT_ENABLED=true
# POST /api/user/login — per-IP only (no JWT yet). 10/min is generous for
# legitimate retries but tight enough to deter credential spraying.
LOGIN_RATE_LIMIT_PER_MINUTE=10
# POST /api/llm/completion — per-user primary. The reverse-RPC path
# (runner → desktop → this endpoint) shares the same user bucket.
LLM_COMPLETION_RATE_LIMIT_PER_MINUTE=60
# Per-IP secondary on the same endpoint, catches "open N accounts to
# multiply LLM quota" abuse. Set high enough that a single user's
# normal traffic is far below this even across multiple devices.
LLM_COMPLETION_RATE_LIMIT_PER_IP_PER_MINUTE=200
# POST /api/media/stt — Whisper is per-call expensive.
MEDIA_STT_RATE_LIMIT_PER_MINUTE=20
# POST /api/media/tts — rate-limit at the handler entry to prevent
# burning provider quota on rejected requests.
MEDIA_TTS_RATE_LIMIT_PER_MINUTE=30
# POST /api/media/image_gen — DALL-E 3 is the most expensive media op.
MEDIA_IMAGE_GEN_RATE_LIMIT_PER_MINUTE=10
# POST /api/media/video_gen — Hailuo runs can take 60–600s and the user
# pays per second of output. Cap well below image_gen.
MEDIA_VIDEO_GEN_RATE_LIMIT_PER_MINUTE=3

# ─── Logging ───
# Literal beats getattr(logging, ...) — typo fails at boot, not in request path.
# stdout only (Docker driver rotates externally).
LOG_LEVEL=INFO
# json for production (Docker logs scrape), text for local dev.
LOG_FORMAT=json
