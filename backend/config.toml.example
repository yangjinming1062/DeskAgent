# ─────────────────────────────────────────────────────────────────────
# SpiritAgent 后端配置模板文件 (config.toml.example)
# SpiritAgent 后端的默认基准配置，由 Git 跟踪维护。
# 可复制此文件为 `config.toml` 进行本地修改（`config.toml` 已被 Git 忽略）。
# 配置优先级：系统环境变量 > .env > config.toml > config.toml.example
# ─────────────────────────────────────────────────────────────────────

[runtime]
# 后端服务名称（用于日志、文档及 OpenAPI 标识）
app_name = "SpiritAgent Backend"
# 统一 API 路由前缀
api_prefix = "/api"
# 后端可被公网访问的基础地址（如 https://example.com）。非空时聊天视频附件以绝对 URL 直发供应商
# （供应商自行拉取，单文件上限=会话配额 512MB）；留空走 base64 内联（单文件上限 50MB）。
# 注意：该地址必须真的能被供应商服务器访问到（反代 / 端口映射就绪），否则供应商拉取会失败。
public_base_url = ""

[database]
# 数据库连接 URL（SQLAlchemy 格式）。在 Docker Compose 环境中服务名为 postgres（端口 5432）
database_url = "postgresql+psycopg://postgres:postgres@postgres:5432/spiritagent"

[auth]
# JWT 签名私钥（生产环境必须修改，长度需 ≥ 16 个字符）
jwt_secret_key = "replace-this-with-a-strong-secret"
# JWT 签名算法
jwt_algorithm = "HS256"
# 登录 Access Token 有效期（分钟），默认 480 分钟（8 小时）
access_token_expire_minutes = 480
# 伴侣头像与 3D 资产 URL 的 HMAC 签名密钥（生产环境必须配置，防止未授权访问）
companion_asset_signing_key = ""
# SSRF 检查 IP 级豁免网段（逗号分隔 CIDR，默认空 = 不豁免）。
# 仅在宿主机代理为 TUN/fake-ip 模式（所有域名解析进 198.18.0.0/15 或 IPv6 fake-ip 段 fdfe:dcba:9876::/64，导致出网被
# SSRF 检查误拦）时配置，例如 "198.18.0.0/15,fdfe:dcba:9876::/64"。注意：该网段内 IP 将跳过
# 保留段拒绝检查（域名黑名单 / 协议白名单 / 云元数据拦截不受影响）。
ssrf_allowed_cidrs = ""
# 初始管理员用户名（首次启动时自动创建）
admin_username = "spiritagent"
# 初始管理员密码（首次启动时自动创建）
admin_password = "spiritagent@admin123"

[storage]
# `/temp-media/{token}` 临时媒体文件的有效存活时长（小时）
temp_file_ttl_hours = 24
# 后端磁盘数据与产物存储根目录（支持相对或绝对路径）
data_dir = "./data"

[image_to_3d]
# 图生 3D 供应商选择：可选 "tripo" 或 "hunyuan"（默认 tripo）
# 商业供应商之间不做自动回退；未配置 Key 时图生 3D 请求将被拒绝（返回 400）
image_to_3d_provider = "tripo"
# 轮询 3D 生成任务状态的间隔时间（秒）
image_to_3d_poll_interval_seconds = 5.0
# 3D 轮询退避上限（秒）；指数退避 base_interval*2**attempt 增长到此值后停止。40s 约为 5s→10s→20s→40s 三档。
image_to_3d_poll_backoff_max_seconds = 40.0
# 轮询 3D 生成任务的最大超时时间（秒）
image_to_3d_max_poll_seconds = 1800.0

# ── Tripo3D 配置（支持云端自动绑骨与多视图生模）──
# Tripo3D API Key
tripo_api_key = ""
# Tripo3D API 基础地址
tripo_base_url = "https://openapi.tripo3d.ai/v3"
# Tripo3D 模型版本
tripo_model_version = "v3.1-20260211"
# 目标面数限制
tripo_face_limit = 2000000
# 纹理贴图质量（detailed / standard）
tripo_texture_quality = "extreme"
# 几何细节质量（detailed / standard）
tripo_geometry_quality = "detailed"
# 是否启用模型自动修复
tripo_enable_autofix = true

# ── 腾讯混元 3D 配置（TokenHub 接入，支持单图/多视图生模；当前无云端绑骨 / 动画绑定能力,产物为静态 GLB,客户端可消费但仅显示静态模型）──
# 腾讯混元 3D API Key
hunyuan_api_key = ""
# 腾讯混元 3D API 基础地址
hunyuan_base_url = "https://tokenhub.tencentmaas.com"
# 混元 3D 模型版本
hunyuan_model_version = "hy-3d-3.1"
# 生成模式：Normal（默认带贴图模型）、LowPoly（减面拓扑）、Geometry（白模无贴图）、Sketch（草图生模）
hunyuan_generate_type = "Normal"
# 目标面数限制（3000 ~ 1500000；配置为 0 或不填则不传递该参数，避免额外计费）
hunyuan_face_count = 1500000
# 是否生成 PBR 材质贴图
hunyuan_enable_pbr = true
# 产物模型格式（默认 glb）
hunyuan_result_format = "GLB"

# 主用 Space 的 Gradio API 基址（免费 HF ZeroGPU，每日额度有限、无 SLA；自托管时替换）
seethrough_space_base = "https://24yearsold-see-through-demo.hf.space/gradio_api"
# 备用 Space 的 Gradio API 基址（魔搭社区 API 专用域名；主用任何失败自动切换，空串禁用备用）
seethrough_fallback_base = "https://studio-ljsabc-see-through.api-inference.modelscope.net/gradio_api"
# 魔搭 API-Inference 的 SDK Token（modelscope.cn 账号设置页创建；备用调用以 Bearer 头携带）
seethrough_fallback_token = ""

[providers]
# 供应商优先回退链（按数组顺序匹配第一个可用的服务商）。支持：mimo, minimax, gemini, grok, zhipu
providers = ["mimo", "minimax", "gemini", "grok", "zhipu"]

# 小米 MiMo 配置
mimo_api_key = ""
mimo_base_url = ""

# MiniMax 配置
minimax_api_key = ""
minimax_base_url = ""

# Google Gemini 配置
gemini_api_key = ""
gemini_base_url = ""

# xAI Grok 配置
grok_api_key = ""
grok_base_url = ""

# 智谱 BigModel 配置
zhipu_api_key = ""
zhipu_base_url = ""

[llm]
# 默认 LLM 供应商（留空则按 providers 列表优先级自动选择）
llm_provider = ""
# LLM API 基础地址（留空则使用对应供应商默认地址）
llm_base_url = ""
# LLM API Key（留空则使用对应供应商的 Key）
llm_api_key = ""
# LLM 模型名称（留空则使用对应供应商默认模型）
llm_model_name = ""
# LLM 上下文 Token 限制（0 表示使用默认配置）
llm_context_tokens = 0
# LLM 请求超时时间（秒，流式整个生命周期的硬上限）
llm_request_timeout_seconds = 300.0
# LLM 流式单 chunk 静默超时时间（秒，SDK 重试在 create() 返回前完成，不消耗此计时）
llm_stream_idle_timeout_seconds = 60.0
# LLM 请求失败最大重试次数
llm_max_retry_attempts = 3
# 重试初始退避延迟（秒）
llm_base_retry_delay = 5.0
# 重试最大延迟（秒）
llm_max_retry_delay = 60.0

[stt]
# 语音识别 (STT) 供应商（如 minimax, mimo；留空按 providers 自动匹配）
stt_provider = ""
stt_base_url = ""
stt_api_key = ""
stt_model_name = ""
stt_context_tokens = 0

[tts]
# 语音合成 (TTS) 供应商（如 minimax, mimo；留空按 providers 自动匹配）
tts_provider = ""
tts_base_url = ""
tts_api_key = ""
tts_model_name = ""
tts_context_tokens = 0

[image_gen]
# 文生图/图像生成供应商（如 zhipu, minimax, mimo；留空按 providers 自动匹配）
image_gen_provider = ""
image_gen_base_url = ""
image_gen_api_key = ""
image_gen_model_name = ""
image_gen_context_tokens = 0

[video_gen]
# 视频生成供应商（如 minimax, zhipu；留空按 providers 自动匹配）
video_gen_provider = ""
video_gen_base_url = ""
video_gen_api_key = ""
video_gen_model_name = ""
video_gen_context_tokens = 0
# 异步视频任务状态轮询间隔（秒）
video_gen_poll_interval_seconds = 5.0
# 视频轮询退避上限（秒）；与 3D 同样 5s 基线 + 三档倍增 = ~40s
video_gen_poll_backoff_max_seconds = 40.0
# 异步视频生成最大轮询超时时间（秒）
video_gen_max_poll_seconds = 900.0
# 工具调用等待视频生成的同步等待时间（秒）
video_gen_tool_wait_seconds = 180.0
# 视频下载最大字节限制（默认 200MB）
video_gen_download_max_bytes = 209715200

[chat]
# 会话上下文压缩触发阈值（达到上下文限制的比例，如 0.70 即 70% 时触发）
context_compression_threshold = 0.70
# 历史会话摘要压缩的目标 Token 数量
context_summary_target_tokens = 2000
# 参与单次摘要压缩的最大历史消息条数
context_summary_max_input_messages = 30
# 是否启用长会话上下文压缩
enable_context_compression = true
# 默认 LLM 上下文 Token 容量兜底值
default_llm_context_tokens = 1000000
# IPC 异步调用等待超时时间（秒）
ipc_future_timeout_seconds = 300.0
# 伴侣活跃会话判定窗口时间（分钟）
chat_active_window_minutes = 30

[rate_limit]
# 是否开启接口速率限制
rate_limit_enabled = true
# 登录接口每分钟请求频次上限
login_rate_limit_per_minute = 10
# 单用户 LLM 对话补全接口每分钟限制
llm_completion_rate_limit_per_minute = 60
# 单 IP LLM 对话补全接口每分钟限制
llm_completion_rate_limit_per_ip_per_minute = 200
# 语音识别接口每分钟限制
media_stt_rate_limit_per_minute = 20
# 语音合成接口每分钟限制
media_tts_rate_limit_per_minute = 30
# 聊天视频附件上传接口每分钟限制
media_video_rate_limit_per_minute = 10
# 伴侣头像生成接口每分钟限制
companion_avatar_generate_rate_limit_per_minute = 3
# 伴侣 3D 模型生成接口每分钟限制
companion_model_generate_rate_limit_per_minute = 1
# 伴侣表情头像生成接口每分钟限制
companion_expression_avatar_generate_rate_limit_per_minute = 10
# 伴侣外观（换装）生成接口每小时限制——每套外观 = 一次立绘生成 + 一切分，成本显著高于头像
companion_outfit_generate_rate_limit_per_hour = 1
# 限流存储后端 URL（留空使用内存存储，分布式环境可配置 Redis 例如 "redis://localhost:6379/0"）
rate_limit_storage_url = ""

[voice]
# 实时语音会话（/api/voice/ws）上行 PCM 采样率，s16le 单声道
voice_uplink_sample_rate = 16000
# 单句上行音频硬上限（秒），超限触发 OVERFLOW 事件并丢弃尾部溢出 PCM
voice_max_utterance_seconds = 60
# 服务端 VAD 起说确认时长（毫秒）
voice_speech_onset_ms = 200
# 服务端断句尾静音（毫秒）——用户停止说话到开始转写的等待
voice_endpoint_silence_ms = 480
# 话语起说预滚（毫秒）——起说确认前的音频回环，保证话语开头瞬态不丢
voice_vad_preroll_ms = 240
# 语音判定门限 = 噪声底 × 该倍率（能量法）
voice_vad_floor_ratio = 2.2
# 插话判定确认时长（毫秒）
voice_bargein_onset_ms = 200
# 下行恢复后的致盲窗（毫秒）——该窗口内上行能量只用于估计回声底，不判插话
voice_bargein_deafen_ms = 250
# 插话门限额外需越过回声底 × 该倍率
voice_bargein_energy_ratio = 2.5
# 子句切分最短字符（软分隔符累计越过后成段，0 = 保持句级切分）
voice_clause_min_chars = 8
# TTS 段强切上限字符数
voice_segment_max_chars = 120
# TTS 段流合成预取窗口（并行开流、按序发送）
voice_tts_prefetch = 2
# 裸 PCM 下行攒块时长（毫秒），段末块不受此限立即冲发
voice_downlink_chunk_ms = 100
# 流式管线总开关（false 时每段整块合成下发，仍享受子句切分与服务端断句）
voice_streaming_enabled = true
# 会话空闲自动挂断（秒），与客户端通话面板的自动退出对齐；"空闲"按语音活动计（持续上行不算活动）
voice_session_idle_timeout_seconds = 180
# 会话硬上限（秒）
voice_session_hard_timeout_seconds = 1800
# 语音会话 STT 每分钟限额（按话语计，独立于 media_stt REST 桶）
voice_stt_rate_limit_per_minute = 60
# 语音会话 TTS 每分钟限额（按段流开启计，子句粒度调用密度高于句级）
voice_tts_rate_limit_per_minute = 240

[observability]
# 是否启用 Prometheus 指标监控端点
metrics_enabled = true
# 指标采集路径
metrics_path = "/metrics"
# 指标采集鉴权 Token（留空则不开启采集鉴权）
metrics_auth_token = ""

[logging]
# 日志级别：DEBUG / INFO / WARNING / ERROR / CRITICAL
log_level = "INFO"
# 日志格式：json / text
log_format = "json"

[llm_debug]
# 是否启用 LLM 调用的 debug 面包屑日志（输出 provider / model / 截断后的输入输出 / 延迟 / 状态）
# 默认关闭，开启后会在 llm.debug logger 上按调用粒度输出详细信息
llm_debug_logging = false
# 单字段最大保留字符数，超过则截断并标注原长度
llm_debug_max_chars = 4000

[channels]
# 外部 IM 通道桥（services/channels）：微信 iLink 适配器已实现，更多渠道按需接入。
# 单 (用户, 渠道) 绑定在途回合期间排队的入站消息上限，超出丢弃最旧排队消息
channels_turn_queue_max = 20
# 每对端（peer）入站限速：进程内滑动窗，渠道侧无频控时的成本护栏
channels_inbound_rate_per_minute = 20
# 适配器非致命错误后的守卫重试退避（秒）
channels_restart_backoff_seconds = 10.0
# 回复分片上限（微信单条消息长度约束，其余渠道共用同一上限）
weixin_reply_max_chars = 2000
# 微信 iLink Bot API 基础地址（个人号官方 Bot API；扫码确认后服务端返回的 baseurl 优先于该默认值）
weixin_ilink_base_url = "https://ilinkai.weixin.qq.com/"
# getupdates 长轮询客户端超时（秒）——服务端 hold ~35s，客户端略放宽
weixin_ilink_poll_timeout_seconds = 40.0

[web_search]
# web_search 使用的搜索后端：ddgs（免密钥）/ brave-free / tavily。所选后端缺密钥时自动回退到 ddgs。
web_search_backend = "ddgs"
# web_extract 使用的抓取后端。目前仅 tavily 支持抓取；留空则沿用 web_search_backend。
web_extract_backend = "tavily"
# Brave 搜索 API Key（搜索后端 = brave-free 时必填，免费档 2k 次/月：https://brave.com/search/api/）
brave_search_api_key = ""
# Tavily API Key（抓取后端 = tavily 时必填：https://app.tavily.com/home）
tavily_api_key = ""
# Tavily 接口地址（留空使用官方默认地址 https://api.tavily.com）
tavily_base_url = ""
