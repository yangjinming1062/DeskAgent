# ---------------------------------------------------------------------------
# Optional Skills / MCP State
# ---------------------------------------------------------------------------
# Skills now live at ``<repo>/installer/bundled-skills/`` and
# ``<repo>/installer/optional-skills/`` for the bundled source. The hub
# state is written under the runtime install location (``~/.zast/skills/``,
# ``~/.zast/optional-skills/``) so these ignores apply wherever the
# patterns appear.
**/skills/.hub/
**/ignored/
**/optional-skills/.hub/
**/optional-mcps/.hub/

# ---------------------------------------------------------------------------
# Tools & MCP
# ---------------------------------------------------------------------------
.mcp.json
.mcp*_token
tool_output/
scripts/out/

# ---------------------------------------------------------------------------
# Database & Cache
# ---------------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
.pip-cache/
.uv-cache/

# ---------------------------------------------------------------------------
# Release & Distribution
# ---------------------------------------------------------------------------
*.nupkg
*.blockmap
.RELEASE_v*.md

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
*.log
logs/
tmp/
temp/
images/
*.ppk
*.pem
privvy*
demo.*

# Tauri payload staging (regenerated by scripts/build_client.{sh,ps1}).
# Symlinks to installer/bundled-skills/ etc. should NEVER be committed.
installer/payload/
