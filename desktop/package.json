{
  "name": "deskagent",
  "productName": "DeskAgent",
  "private": true,
  "version": "0.2.0",
  "description": "Native desktop shell for DeskAgent Agent.",
  "author": "DeskAgent",
  "type": "module",
  "main": "electron/main.cjs",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "11.5.2"
  },
  "scripts": {
    "dev": "node scripts/assert-root-install.cjs && concurrently -k \"pnpm dev:renderer\" \"wait-on http://127.0.0.1:5174 && cross-env XCURSOR_SIZE=24 DESKAGENT_DESKTOP_DEV_SERVER=http://127.0.0.1:5174 electron .\"",
    "dev:renderer": "node scripts/assert-root-install.cjs && vite --host 127.0.0.1 --port 5174",
    "build": "node scripts/assert-root-install.cjs && node scripts/write-build-stamp.cjs && node scripts/stage-native-deps.cjs && tsc -b && vite build && node scripts/assert-dist-built.cjs",
    "builder": "cross-env NODE_OPTIONS=--max-old-space-size=16384 electron-builder",
    "pack": "pnpm run build && pnpm run builder -- --dir",
    "dist": "pnpm run build && pnpm run builder",
    "dist:mac:dmg": "pnpm run build && pnpm run builder -- --mac dmg",
    "dist:win": "pnpm run build && pnpm run builder -- --win",
    "dist:win:nsis": "pnpm run build && pnpm run builder -- --win nsis",
    "dist:linux": "pnpm run build && pnpm run builder -- --linux AppImage deb rpm",
    "test:desktop:all": "node scripts/test-desktop.mjs all",
    "test:desktop:platforms": "node --test electron/bootstrap-platform.test.cjs electron/hardening.test.cjs electron/gateway-ws-probe.test.cjs electron/runner-rpc-ws.test.cjs electron/runner-reverse-rpc.test.cjs electron/runner-bridge.test.cjs",
    "type-check": "tsc -b",
    "lint": "eslint src/ electron/",
    "lint:fix": "eslint src/ electron/ --fix",
    "fmt": "prettier --write \"src/**/*.{ts,tsx}\" \"electron/**/*.{js,cjs,mjs}\" \"scripts/**/*.{cjs,mjs}\" \"vite.config.ts\"",
    "fix": "pnpm run lint:fix && pnpm run fmt && pnpm run type-check",
    "test:ui": "vitest run"
  },
  "dependencies": {
    "electron-log": "^5.2.0",
    "electron-updater": "^6.6.2",
    "node-pty": "1.1.0",
    "ws": "^8.21.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.2",
    "@types/hast": "^3.0.4",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^42.4.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.4",
    "eslint-plugin-perfectionist": "^5.9.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.5",
    "wait-on": "^9.0.5",
    "@assistant-ui/core": "^0.2.18",
    "@assistant-ui/react": "^0.14.23",
    "@assistant-ui/react-streamdown": "^0.3.4",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@icons-pack/react-simple-icons": "^13.13.0",
    "@nanostores/react": "^1.1.0",
    "@nous-research/ui": "^0.13.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@streamdown/code": "^1.1.1",
    "@tabler/icons-react": "^3.41.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/react-query": "^5.100.6",
    "@tanstack/react-virtual": "^3.13.24",
    "@vscode/codicons": "^0.0.45",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "hast-util-from-html-isomorphic": "^2.0.0",
    "hast-util-to-text": "^4.0.2",
    "ignore": "^7.0.5",
    "katex": "^0.16.45",
    "leva": "^0.10.1",
    "motion": "^12.38.0",
    "nanostores": "^1.3.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.5",
    "react-arborist": "^3.5.0",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.17.0",
    "react-shiki": "^0.9.3",
    "remark-math": "^6.0.0",
    "shiki": "^4.0.2",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "tw-shimmer": "^0.4.11",
    "unicode-animations": "^1.0.3",
    "unified": "^11.0.5",
    "unist-util-visit-parents": "^6.0.2",
    "vfile": "^6.0.3",
    "web-haptics": "^0.0.6"
  },
  "build": {
    "appId": "io.deskagent.agent",
    "productName": "DeskAgent",
    "executableName": "DeskAgent",
    "artifactName": "DeskAgent-${version}-${os}-${arch}.${ext}",
    "icon": "assets/icon",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "assets/**",
      "electron/**",
      "package.json"
    ],
    "npmRebuild": false,
    "beforePack": "scripts/before-pack.cjs",
    "extraResources": [
      {
        "from": "config.json",
        "to": "config.json"
      },
      {
        "from": "build/install-stamp.json",
        "to": "install-stamp.json"
      },
      {
        "from": "build/native-deps",
        "to": "native-deps"
      },
      {
        "from": "assets/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "../scripts/secrets/update.pub",
        "to": "update.pub"
      }
    ],
    "asar": true,
    "afterSign": "scripts/notarize.cjs",
    "asarUnpack": [
      "**/*.node",
      "**/prebuilds/**",
      "dist/**"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "entitlements": "electron/entitlements.mac.plist",
      "entitlementsInherit": "electron/entitlements.mac.inherit.plist",
      "extendInfo": {
        "CFBundleDisplayName": "DeskAgent",
        "CFBundleExecutable": "DeskAgent",
        "CFBundleName": "DeskAgent",
        "NSAudioCaptureUsageDescription": "DeskAgent uses audio capture for voice conversations.",
        "NSMicrophoneUsageDescription": "DeskAgent uses the microphone for voice input and voice conversations."
      },
      "gatekeeperAssess": false,
      "hardenedRuntime": true,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "title": "Install DeskAgent",
      "backgroundColor": "#f5f5f7",
      "iconSize": 96,
      "window": {
        "width": 560,
        "height": 360
      },
      "contents": [
        {
          "x": 160,
          "y": 170,
          "type": "file"
        },
        {
          "x": 400,
          "y": 170,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "legalTrademarks": "DeskAgent",
      "target": [
        "nsis",
        "msi"
      ]
    },
    "linux": {
      "category": "Development",
      "maintainer": "DeskAgent <support@deskagent.ai>",
      "synopsis": "Native desktop shell for DeskAgent Agent.",
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "DeskAgent",
      "uninstallDisplayName": "DeskAgent",
      "warningsAsErrors": false
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://resolved-at-runtime.invalid/api/update",
        "channel": "latest",
        "useMultipleRangeRequest": false,
        "updaterCacheDirName": "deskagent-updater"
      }
    ]
  }
}
